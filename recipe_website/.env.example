# Database (Optional - use "demo" for demo mode without database)
DATABASE_URL="postgresql://user:password@localhost:5432/recipe_db?schema=public"
# DATABASE_URL="demo"  # Uncomment this to enable demo mode

# NextAuth (Optional - defaults provided)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="demo-secret-change-in-production"

# OAuth (Optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_ID=""
# GITHUB_SECRET=""

# Image Upload (Optional - for Cloudinary)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
