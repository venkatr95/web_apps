// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  pin           String?   // 4-6 digit PIN for quick login
  role          UserRole  @default(USER)
  bio           String?
  website       String?
  location      String?
  preferences   Json?     // {units: "metric"|"imperial", dietaryRestrictions: []}
  
  // New fields for adaptive recommendations
  foodMemoryMap Json?     // Track user's habitual choices and preferences
  ingredientScalingPrefs Json? // User's preferred scaling for spice, oil, water (1.8-2.1x)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  recipes       Recipe[]
  reviews       Review[]
  favorites     Favorite[]
  accounts      Account[]
  sessions      Session[]
  collections   Collection[]
  comments      Comment[]
  followers     Follow[]     @relation("UserFollowers")
  following     Follow[]     @relation("UserFollowing")
  achievements  UserAchievement[]
  notifications Notification[]
  shoppingLists ShoppingList[]
  wizardStates  WizardState[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Recipe {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  imageUrl        String
  prepTime        Int            // in minutes
  cookTime        Int            // in minutes
  totalTime       Int            // in minutes
  servings        Int
  difficulty      Difficulty
  cuisine         CuisineType
  category        RecipeCategoryType
  mealCourse      MealCourse
  country         Country
  instructions    String         @db.Text
  published       Boolean        @default(false)  // Changed: default to false for approval workflow
  approved        Boolean        @default(false)  // New: admin approval status
  featured        Boolean        @default(false)
  views           Int            @default(0)
  likes           Int            @default(0)
  saves           Int            @default(0)
  
  // New fields for adaptive recommendations
  pageVisits      Int            @default(0)  // Track recipe page visits
  spiceLevel      Int?           // 1-5 scale for spice intensity
  dietType        DietType?      // Dietary classification
  complementRecipeIds String[]   // Array of recipe IDs that complement this dish
  mealTypeTimeRangeStart String? // e.g., "11:30" for lunch start
  mealTypeTimeRangeEnd   String? // e.g., "14:30" for lunch end
  emotionTags     String[]       // e.g., ["comforting", "refreshing", "indulgent"]
  origin          String?        // Recipe origin/region
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  categories      RecipeCategory[]
  ingredients     Ingredient[]
  reviews         Review[]
  favorites       Favorite[]
  nutritionInfo   NutritionInfo?
  collections     CollectionRecipe[]
  comments        Comment[]
  shoppingListItems ShoppingListItem[]

  @@index([slug])
  @@index([authorId])
  @@index([cuisine])
  @@index([mealCourse])
  @@index([country])
  @@index([difficulty])
  @@index([published])
  @@index([pageVisits])
  @@index([dietType])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

