  "createRecipeExample": {
    "title": "Classic Margherita Pizza",
    "description": "A traditional Italian pizza with fresh tomatoes, mozzarella, and basil. Simple yet incredibly delicious, this recipe captures the essence of Neapolitan cuisine.",
    "imageUrl": "https://images.unsplash.com/photo-1574071318508-1cdbab80d002",
    "prepTime": 20,
    "cookTime": 15,
    "servings": 4,
    "difficulty": "MEDIUM",
    "cuisine": "ITALIAN",
    "category": "WORLD_RECIPES",
    "mealCourse": "DINNER",
    "country": "ITALY",
    "instructions": "1. Preheat your oven to 475°F (245°C) with a pizza stone inside.\n2. Roll out the pizza dough on a floured surface to your desired thickness.\n3. Spread tomato sauce evenly over the dough, leaving a 1-inch border.\n4. Tear the mozzarella and distribute it evenly over the sauce.\n5. Drizzle with olive oil and season with salt.\n6. Transfer to the preheated pizza stone and bake for 12-15 minutes until crust is golden.\n7. Remove from oven and immediately top with fresh basil leaves.\n8. Let cool for 2 minutes, slice, and serve hot.",
    "categories": ["dinner", "lunch", "main_course"],
    "ingredients": [
      {
        "name": "Pizza dough",
        "amount": "1",
        "unit": "ball"
      },
      {
        "name": "Tomato sauce",
        "amount": "1/2",
        "unit": "cup"
      },
      {
        "name": "Fresh mozzarella",
        "amount": "8",
        "unit": "oz"
      },
      {
        "name": "Fresh basil leaves",
        "amount": "1/4",
        "unit": "cup"
      },
      {
        "name": "Olive oil",
        "amount": "2",
        "unit": "tbsp"
      },
      {
        "name": "Salt",
        "amount": "1",
        "unit": "tsp"
      }
    ],
    "spiceLevel": 1,
    "dietType": "VEGETARIAN",
    "emotionTags": ["comforting", "classic", "satisfying"],
    "origin": "Naples, Italy"
