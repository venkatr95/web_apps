# Copy to .env.local and fill secrets.
# API host is chosen by environment (see .env.development / .env.production):
#   next dev  → http://localhost:8000
#   Vercel    → https://ridematch-app.onrender.com

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Bike taxis (must match server BIKE_TAXIS / bike-taxis)
# NEXT_PUBLIC_BIKE_TAXIS=true

# --- Optional overrides (uncomment only if needed) ---
# Force Render while developing:
# NEXT_PUBLIC_API_URL=https://ridematch-app.onrender.com
# NEXT_PUBLIC_WS_URL=wss://ridematch-app.onrender.com/ws
