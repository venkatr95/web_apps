{
  "info": {
    "name": "Recipe App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "Get All Channels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "channels"
              ]
            }
          }
        },
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/channels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "channels"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HealthyBites\",\n  \"tag\": \"health\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/recipes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "recipes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Avocado Toast\",\n  \"content\": \"Toast + Avocado = \\u2764\\ufe0f\",\n  \"tag\": \"avocado\",\n  \"channelId\": \"{{channelId}}\"\n}"
            }
          }
        },
        {
          "name": "Get Recipes by Channel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/recipes/channel/{{channelId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "recipes",
                "channel",
                "{{channelId}}"
              ]
            }
          }
        },
        {
          "name": "Like Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/recipes/{{recipeId}}/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}",
                "like"
              ]
            }
          }
        },
        {
          "name": "Heart Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/recipes/{{recipeId}}/heart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}",
                "heart"
              ]
            }
          }
        }
      ]
    }
  ]
}